# Copie para .env com valores reais e carregue no terminal (set -a; source .env; set +a) ou exporte
# as variáveis: o app não lê o arquivo sozinho. Nunca versione valores reais.
PORT=3000
LOG_LEVEL=info
# ":memory:" (padrão) ou caminho de um arquivo SQLite
DB_FILE=:memory:
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas. Vazio = rotas admin respondem 401.
ADMIN_TOKEN=
# Senha do usuário semente (leonan@fullcycle.com.br). Vazio = senha aleatória, nunca exibida.
SEED_USER_PASSWORD=
