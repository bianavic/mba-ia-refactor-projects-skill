# Copy to .env (or export) — never commit real values.
# Token signing key. Without it a random key is generated on every boot (tokens die on restart).
SECRET_KEY=
# Flask/Werkzeug debug: NEVER enable on an exposed host (the debugger executes code).
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
DATABASE_URL=sqlite:///tasks.db
TOKEN_TTL_SECONDS=3600
# Passwords of the seeded accounts (admin; regular users). An account without a password is not created.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
