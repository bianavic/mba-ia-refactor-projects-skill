# Obrigatório fora de desenvolvimento: assina os tokens de login.
# A aplicação se recusa a subir sem ele (não há default no código — um default
# versionado seria uma chave pública, e qualquer um poderia forjar um token).
# Gere o seu com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production (default: production)
# Em development, uma chave efêmera é gerada a cada boot quando SECRET_KEY está
# vazia — os tokens emitidos morrem no restart, então não servem para forjar sessão.
FLASK_ENV=development

DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
CORS_ORIGINS=*

# Validade do token de login, em segundos (default: 86400 = 24h)
TOKEN_MAX_AGE_SECONDS=86400
