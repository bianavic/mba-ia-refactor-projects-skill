# Copie para .env (ou exporte) — nunca commite valores reais.
# Chave de assinatura dos tokens. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# Debug do Flask/Werkzeug: NUNCA ligue em ambiente exposto (o debugger executa código).
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
DB_PATH=loja.db
TOKEN_TTL_SECONDS=3600
# Senhas das contas do seed (admin e clientes de exemplo). Conta sem senha não é criada.
ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# RISCO: liga POST /admin/query, que executa SQL arbitrário (somente admin, registrado por id).
# Deixe false fora de manutenção controlada.
ADMIN_QUERY_ENABLED=false
