# Copie para .env (ou exporte) com valores reais. Nunca versione valores reais.
PORT=3000
LOG_LEVEL=info
# ":memory:" (padrão) ou caminho de um arquivo SQLite
DB_FILE=:memory:
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas. Vazio = rotas admin respondem 401.
ADMIN_TOKEN=
# Senha do usuário semente (leonan@fullcycle.com.br). Vazio = senha aleatória, nunca exibida.
SEED_USER_PASSWORD=
